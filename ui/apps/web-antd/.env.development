# 端口号
VITE_PORT=5666

VITE_BASE=/

# 接口地址：测试环境域名 aiarsenal.cc（gin 后端已开 CORS，echo Origin + Allow-Credentials）
# 目标机用 /etc/hosts 把 *.aiarsenal.cc 指向 127.0.0.1，浏览器以 http 访问本机 nginx→gin
VITE_GLOB_API_URL=http://api.aiarsenal.cc

# 关闭 Nitro Mock（接真实后端）
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
