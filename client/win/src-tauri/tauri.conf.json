{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Arsenal",
  "version": "0.1.0",
  "identifier": "cc.aiarsenal.client",
  "build": {
    "frontendDist": "../../shared/frontend/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "cd ../shared/frontend && npm run dev -- --port 5174 --strictPort",
    "beforeBuildCommand": "cd ../shared/frontend && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AI Arsenal",
        "width": 1040,
        "height": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["aiarsenal"]
      }
    }
  }
}
