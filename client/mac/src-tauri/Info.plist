<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  与 tauri-build 生成的默认 Info.plist 合并：补 macOS TCC usage description 键。
  缺这些键时，Contacts/Calendar/Reminders/Photos/Location/Camera 的 requestAccess 会被
  系统静默吞掉（API 调了但不弹框）——这是 desktop node 6 个 TCC 命令首次调用无法弹授权框的根因。
  文案在系统授权框里展示给用户，说明「为何需要该权限 + 来自哪个 node 命令」。
-->
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>
  <string>cc.aiarsenal.client</string>
  <key>NSContactsUsageDescription</key>
  <string>执行 contacts.search 节点命令时需要读取通讯录以返回联系人信息。</string>
  <key>NSCalendarsUsageDescription</key>
  <string>执行 calendar.events 节点命令时需要读取日历以返回日程。</string>
  <key>NSRemindersUsageDescription</key>
  <string>执行 reminders.list 节点命令时需要读取提醒事项。</string>
  <key>NSPhotoLibraryUsageDescription</key>
  <string>执行 photos.latest 节点命令时需要读取照片以返回最近图片。</string>
  <key>NSCameraUsageDescription</key>
  <string>执行 camera.snap / camera.clip 节点命令时需要使用摄像头拍照或录像。</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>执行 camera.clip 节点命令（含音频）时需要使用麦克风录音。</string>
  <key>NSLocationUsageDescription</key>
  <string>执行 location.get 节点命令时需要获取定位以返回经纬度。</string>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>执行 location.get 节点命令时需要获取定位以返回经纬度。</string>
</dict>
</plist>
